{
  "templates": [
    {
      "code": "for i in range({n}):\n    print(i)",
      "desc": "{n}번 반복하여 숫자 출력"
    },
    {
      "code": "def add(a, b):\n    return a + b",
      "desc": "두 수를 더하는 함수"
    },
    {
      "code": "if {x} > {y}:\n    print('크다')\nelse:\n    print('작거나 같다')",
      "desc": "{x}와 {y} 비교 조건문"
    },
    {
      "code": "numbers = [x**2 for x in range({n})]",
      "desc": "제곱수를 담은 리스트 생성"
    },
    {
      "code": "try:\n    result = int('{val}')\nexcept ValueError:\n    print('Error!')",
      "desc": "문자열을 정수로 변환 시도"
    },
    {
      "code": "with open('file.txt', 'w') as f:\n    f.write('Hello')",
      "desc": "파일에 문자열 쓰기"
    },
    {
      "code": "class Person:\n    def __init__(self, name):\n        self.name = name",
      "desc": "클래스 정의 예제"
    },
    {
      "code": "print('Hello, {}'.format('{name}'))",
      "desc": "format()을 이용한 문자열 포매팅"
    }
  ]
}
